{
  "expo": {
    "name": "voice-journal-app",
    "slug": "voice-journal-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.charlton.voicejournal",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app needs microphone access to record your voice journal entries.",
        "NSFaceIDUsageDescription": "Face ID is used to lock access to your journal."
      }
    },
    "android": {
      "package": "com.charlton.voicejournal",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0E0E10",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      "expo-secure-store"
    ]
  }
}
